{
  "name": "local-whisper-web",
  "version": "0.1.0-beta.1",
  "description": "Install-free, privacy-first Whisper transcription that runs entirely in the browser.",
  "private": true,
  "license": "MIT",
  "author": "psych0h3ad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psych0h3ad/local-whisper-web.git"
  },
  "keywords": [
    "whisper",
    "speech-to-text",
    "transcription",
    "webgpu",
    "wasm",
    "privacy"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "npm run typecheck && npm run lint && npm run build && node --test tests/*.test.mjs",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.45",
    "vite": "8.2.1",
    "wrangler": "4.122.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "type": "module"
}
